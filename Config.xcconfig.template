// Local, per-developer settings — do NOT commit this file.
// Copy from Config.xcconfig.template and fill in your own values.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = com.yourcompany.kotek

// Supabase → Project Settings → API. The publishable key is meant to ship in
// the client — RLS, not secrecy, protects the rows. Keep the `$()`: it splits
// the `//`, which xcconfig would otherwise read as the start of a comment.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = YOUR_PUBLISHABLE_KEY
