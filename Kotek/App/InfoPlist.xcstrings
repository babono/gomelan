    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kotek connects to the gangsa's strike sensors, so it can feel exactly which bar you hit and when."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotek tersambung ke sensor di gangsamu, supaya tahu persis bilah mana yang kamu pukul dan kapan."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kotek records the sound of each bilah when you add a gangsa, so practice plays your own instrument, and listens for voice commands like “slower” or “pause” while your hands are busy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotek merekam bunyi tiap bilah saat kamu menambahkan gangsa, supaya latihan memakai suara instrumenmu sendiri, juga mendengarkan perintah suara seperti “pelan” atau “jeda” saat tanganmu sibuk."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kotek recognises voice commands like “slower” or “pause” on this device while your hands are busy playing."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotek mengenali perintah suara seperti “pelan” atau “jeda” langsung di perangkat ini, saat tanganmu sibuk bermain."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
