<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Kotek</string>

	<!-- Required: the app requests both on first run. Without these iOS
	     terminates the process at the permission prompt rather than denying
	     it, and App Store review rejects the build. Worded for the person
	     being asked, not for us. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Kotek records the sound of each bilah when you add a gangsa, so practice plays your own instrument, and listens for voice commands like “slower” or “pause” while your hands are busy.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Kotek recognises voice commands like “slower” or “pause” on this device while your hands are busy playing.</string>

	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Kotek connects to the gangsa's strike sensors, so it can feel exactly which bar you hit and when.</string>

	<!-- Filled from Config.xcconfig at build time. Read by RemoteStore. -->
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>

	<!-- Answers the export-compliance question at upload instead of on every
	     build. True only in the sense that HTTPS is used; no encryption is
	     implemented here. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The launch screen is the FIRST thing shown, before any of our code
	     runs, and by default it is a plain white page. Against a splash screen
	     on the warm brown ground that reads as a white flash on every launch,
	     which is exactly the kind of thing a splash screen is supposed to stop.
	     Painting it the same brown makes launch → splash one continuous surface
	     with only the wordmark fading up on top of it. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Putih</string>
	</dict>

	<key>UIAppFonts</key>
	<array>
		<string>Katibeh-Regular.ttf</string>
	</array>
</dict>
</plist>
