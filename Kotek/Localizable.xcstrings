        }
      }
    },
    "After a session, the results show how each stroke of the cycle went on average, so you can see which part of the pattern needs work." : {
      "comment" : "Text for the \"Where it slipped\" section of the app guide.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah sesi selesai, hasilnya menunjukkan rata-rata tiap pukulan dalam satu putaran, jadi kamu tahu bagian pola mana yang perlu dilatih lagi."
          }
        }
      }
    },
    "All" : {
