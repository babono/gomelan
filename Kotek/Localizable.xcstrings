    },
    "Use your **camera** to get real-time feedback on your technique and timing." : {
      "comment" : "Text displayed in a slide that explains how to use camera feedback for playing the Interlock.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakai **kamera** untuk langsung tahu bagaimana teknik dan ketepatan pukulanmu."
