        }
      }
    },
    "%@ and its setup, photo and sounds will be deleted from all devices. This can't be undone." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beserta pengaturan, foto, dan rekaman suaranya akan dihapus dari semua perangkat. Ini tidak bisa dibatalkan."
          }
        }
      }
    },
    "%@ connected" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tersambung"
          }
        }
      }
    },
    "%@ is protected. Ask its owner for the 4-digit PIN." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dilindungi PIN. Minta PIN 4 digitnya ke pemiliknya, ya."
