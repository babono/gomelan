    },
    "Any phone nearby can use this controller." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponsel mana pun di dekat sini bisa memakai kontroler ini."
          }
        }
      }
    },
    "As a guest, your gangsa and records are only on this iPhone. Link an Apple ID to keep them if you delete the app or change phones." : {
      "comment" : "A description of how a guest's data is managed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebagai tamu, gangsa dan rekormu hanya ada di iPhone ini. Tautkan Apple ID supaya tetap aman kalau aplikasinya terhapus atau kamu ganti ponsel."
          }
        }
      }
    },
    "As a guest, your progress stays on this iPhone only." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebagai tamu, progresmu hanya tersimpan di iPhone ini."
          }
        }
      }
    },
    "Attach the sensor under each key, and make sure the key still sounds clear." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasang sensor di bawah tiap bilah, dan pastikan bilahnya tetap berbunyi jernih."
          }
        }
      }
    },
    "Audio isn't ready. Try again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio belum siap. Coba lagi, ya."
          }
        }
      }
