    "Each card draws its pattern across one gong cycle: time runs left to right, and the keys go low to high up the side. Swipe to hear the next." : {
      "comment" : "Legend for the Kotekan guide.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap kartu menggambarkan polanya dalam satu putaran gong: waktu berjalan dari kiri ke kanan, dan bilah dari nada rendah ke tinggi di sisi samping. Usap untuk mendengar pola berikutnya."
          }
        }
      }
    },
