        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polos jatuh di ketukan, sangsih menyahut di sela-selanya. Tukar kapan saja — gong tetap berjalan, dan skor tiap bagian disimpan sendiri-sendiri."
          }
        }
      }
    },
